---
interface Props {
  current?: string;
}

const { current = Astro.url.pathname } = Astro.props;
---

<header class="site-header" data-behaviour="sticky" data-mobile="dropdown">
  <div class="site-header__inner container">
    <div class="site-header__brand">
      <a class="wordmark" href="/" aria-label="Samla home"><span class="wordmark__mark" aria-hidden="true"></span>Samla</a>
      <span class="badge" data-variant="pill">v1.0</span>
    </div>
    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        <li class="site-nav__item"><a class="site-nav__link" href="/docs/" aria-current={current === '/docs/' ? 'page' : undefined}>Philosophy</a></li>
        <li class="site-nav__item"><a class="site-nav__link" href="/style-guide/" aria-current={current === '/style-guide/' ? 'page' : undefined}>Style Guide</a></li>
        <li class="site-nav__item"><a class="site-nav__link" href="/templates/" aria-current={current === '/templates/' ? 'page' : undefined}>Examples</a></li>
      </ul>
      <div class="site-nav__mobile-actions">
        <a class="button" data-variant="secondary" data-width="full" href="https://github.com/benwellby/samla-ui">GitHub <svg class="icon" data-size="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5l5-5M4.5 3.5h4v4"/></svg></a>
      </div>
    </nav>
    <div class="site-header__actions">
      <a class="button" data-variant="secondary" data-size="small" href="https://github.com/benwellby/samla-ui">GitHub <svg class="icon" data-size="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5l5-5M4.5 3.5h4v4"/></svg></a>
      <button class="site-header__toggle" type="button" aria-label="Open menu" data-label-open="Open menu" data-label-close="Close menu">
        <svg class="icon" data-icon="menu" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 8h16M3 14h16"/></svg>
        <svg class="icon" data-icon="close" viewBox="0 0 22 22" aria-hidden="true"><path d="M5 5l12 12M17 5L5 17"/></svg>
      </button>
    </div>
  </div>
</header>
