---
import FieldworkLayout from '../../layouts/FieldworkLayout.astro';
---

<FieldworkLayout
  title="Fieldwork | Landscape architecture"
  description="Fieldwork is a landscape architecture studio designing parks, streets and squares with councils and developers across the UK."
>
  <main id="main">
    <!-- Template: Homepage. Hero / Logo rail / Card grid / Feature rows / Media + content / Stats / Quote / Related / CTA -->

    <section class="hero" data-layout="text" aria-labelledby="hero-title">
      <div class="hero__inner container">
        <div class="hero__content">
          <p class="hero__eyebrow">Fieldwork / Landscape architecture</p>
          <h1 class="hero__title text-display" id="hero-title">Public spaces designed to be used, and to last.</h1>
        </div>
        <dl class="hero__aside meta-list">
          <div><dt>Founded</dt><dd>2009, Bristol</dd></div>
          <div><dt>Studios</dt><dd>Bristol and Glasgow</dd></div>
          <div><dt>Team</dt><dd>24 designers and ecologists</dd></div>
          <div><dt>Clients</dt><dd>Councils, developers and trusts</dd></div>
        </dl>
        <div class="hero__body">
          <p class="hero__lead text-lead">A small studio working with councils and developers on parks, streets and squares. We design for the people who use a place every day, and for the decades after we leave.</p>
          <div class="hero__actions button-group" data-stack="mobile">
            <a class="button" href="/templates/case-studies/">View projects <svg class="icon" data-icon="arrow-right" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
            <a class="button" data-variant="secondary" href="/templates/about/">About the studio</a>
          </div>
        </div>
        <figure class="hero__media media" data-ratio="cinema">
          <img src="https://placehold.co/1600x1200/ECEAE4/5C5B57" alt="A new riverside park at dusk, with grassed terraces stepping down to the water" width="1600" height="1200" fetchpriority="high">
        </figure>
      </div>
    </section>

    <section class="section" data-spacing="compact" aria-label="Clients">
      <div class="container">
        <div class="logo-rail">
          <p class="label">Trusted by</p>
          <ul class="logo-list" data-layout="rail">
            <li class="logo"><img src="https://placehold.co/110x40/ECEAE4/5C5B57" alt="Halden Council" width="110" height="40"></li>
            <li class="logo"><img src="https://placehold.co/150x40/ECEAE4/5C5B57" alt="Oakmere Homes" width="150" height="40"></li>
            <li class="logo"><img src="https://placehold.co/140x40/ECEAE4/5C5B57" alt="Northgate Trust" width="140" height="40"></li>
            <li class="logo"><img src="https://placehold.co/120x40/ECEAE4/5C5B57" alt="Parallel Developments" width="120" height="40"></li>
            <li class="logo"><img src="https://placehold.co/160x40/ECEAE4/5C5B57" alt="Linden and Co" width="160" height="40"></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="projects-title">
      <div class="container">
        <header class="section-header">
          <p class="section-header__label">Selected projects</p>
          <h2 class="section-header__title text-section-heading" id="projects-title">Places that have become part of everyday life.</h2>
          <div class="section-header__action"><a class="link" href="/templates/case-studies/">All projects</a></div>
        </header>
        <ul class="grid" data-columns="3" role="list">
          <li>
            <article class="card">
              <figure class="card__media media" data-ratio="standard"><img src="https://placehold.co/1600x1200/ECEAE4/5C5B57" alt="" width="1600" height="1200" loading="lazy"></figure>
              <p class="card__meta"><span>Parks</span><span>Halden, 2025</span></p>
              <h3 class="card__title"><a class="card__link" href="/templates/case-study/">Millbrook Riverside Park</a></h3>
              <p class="card__summary">Eleven hectares of former railway sidings, returned to the river as terraces, meadow and play.</p>
            </article>
          </li>
          <li>
            <article class="card">
              <figure class="card__media media" data-ratio="standard"><img src="https://placehold.co/1600x1200/ECEAE4/5C5B57" alt="" width="1600" height="1200" loading="lazy"></figure>
              <p class="card__meta"><span>Streets</span><span>Glasgow, 2024</span></p>
              <h3 class="card__title"><a class="card__link" href="/templates/case-study/">Garnet Street</a></h3>
              <p class="card__summary">A four-lane road made into a planted street with room to cross, sit and trade.</p>
            </article>
          </li>
          <li>
            <article class="card">
              <figure class="card__media media" data-ratio="standard"><img src="https://placehold.co/1600x1200/ECEAE4/5C5B57" alt="" width="1600" height="1200" loading="lazy"></figure>
              <p class="card__meta"><span>Masterplanning</span><span>Oakmere, 2026</span></p>
              <h3 class="card__title"><a class="card__link" href="/templates/case-study/">Oakmere Fields</a></h3>
              <p class="card__summary">Landscape-led masterplan for 900 homes arranged around an existing hedgerow network.</p>
            </article>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" data-surface="alternate" aria-labelledby="services-title">
      <div class="container">
        <header class="section-header">
          <p class="section-header__label">Services</p>
          <h2 class="section-header__title text-section-heading" id="services-title">Four ways we work with clients.</h2>
          <div class="section-header__action"><a class="link" href="/templates/services/">All services</a></div>
        </header>
        <div class="section__body" data-indent>
          <ol class="feature-list" role="list">
            <li class="feature" data-layout="row" data-size="large">
              <h3 class="feature__title">Parks and open space</h3>
              <div class="feature__body">
                <p class="feature__text">From pocket parks to regional landscapes, designed with the communities who will look after them.</p>
                <a class="link" data-variant="arrow" href="/templates/service/">Parks and open space <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
              </div>
            </li>
            <li class="feature" data-layout="row" data-size="large">
              <h3 class="feature__title">Streets and public realm</h3>
              <div class="feature__body">
                <p class="feature__text">Street redesigns that make walking, cycling and staying the obvious choice.</p>
                <a class="link" data-variant="arrow" href="/templates/service/">Streets and public realm <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
              </div>
            </li>
            <li class="feature" data-layout="row" data-size="large">
              <h3 class="feature__title">Masterplanning</h3>
              <div class="feature__body">
                <p class="feature__text">Landscape-led frameworks for new neighbourhoods, starting from what is already on the site.</p>
                <a class="link" data-variant="arrow" href="/templates/service/">Masterplanning <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
              </div>
            </li>
            <li class="feature" data-layout="row" data-size="large">
              <h3 class="feature__title">Community engagement</h3>
              <div class="feature__body">
                <p class="feature__text">Workshops, walks and pop-up studios that shape a brief before a line is drawn.</p>
                <a class="link" data-variant="arrow" href="/templates/service/">Community engagement <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="studio-title">
      <div class="container">
        <div class="media-content">
          <figure class="media-content__media media" data-ratio="portrait">
            <img src="https://placehold.co/1600x1200/ECEAE4/5C5B57" alt="The Fieldwork studio in a converted warehouse in Bristol" width="1600" height="1200" loading="lazy">
          </figure>
          <div class="media-content__body">
            <p class="label">The studio</p>
            <h2 class="text-section-heading" id="studio-title">Designers, ecologists and engineers at one table.</h2>
            <p class="text-lead text-muted">Every project is led by a partner and shaped by a mixed team from the first site visit. It keeps decisions close to the ground and the drawings honest.</p>
            <a class="link" data-variant="arrow" href="/templates/about/">How we work <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="impact-title">
      <div class="container">
        <header class="section-header">
          <p class="section-header__label">Impact</p>
          <h2 class="section-header__title text-section-heading" id="impact-title">Measured after the ribbon is cut.</h2>
        </header>
        <dl class="stat-list">
          <div class="stat"><dt class="stat__label">Hectares of public space</dt><dd class="stat__value">146</dd><dd class="stat__text">Designed and delivered since 2009.</dd></div>
          <div class="stat"><dt class="stat__label">Trees planted</dt><dd class="stat__value">18,400</dd><dd class="stat__text">With a 94% five-year survival rate.</dd></div>
          <div class="stat"><dt class="stat__label">Residents engaged</dt><dd class="stat__value">32k</dd><dd class="stat__text">Through workshops, walks and surveys.</dd></div>
          <div class="stat"><dt class="stat__label">Landscape Institute awards</dt><dd class="stat__value">11</dd><dd class="stat__text">Including two Presidents’ awards.</dd></div>
        </dl>
      </div>
    </section>

    <section class="section" data-surface="dark" aria-label="Testimonial">
      <div class="container">
        <figure class="quote" data-size="large">
          <blockquote class="quote__text"><p>Fieldwork listened longer than anyone we have worked with. The park works because the people who use it helped design it.</p></blockquote>
          <figcaption class="quote__cite">
            <span class="avatar"><img src="https://placehold.co/1200x1500/ECEAE4/5C5B57" alt="" width="1200" height="1500"></span>
            <span><span class="quote__name">Amara Okafor</span><span class="quote__role">Head of Parks, Halden Council</span></span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section" aria-labelledby="journal-title">
      <div class="container">
        <header class="section-header">
          <p class="section-header__label">Journal</p>
          <h2 class="section-header__title text-section-heading" id="journal-title">Notes from the studio.</h2>
          <div class="section-header__action"><a class="link" href="/templates/articles/">All articles</a></div>
        </header>
        <ul class="grid" data-columns="3" role="list">
          <li>
            <article class="card">
              <figure class="card__media media" data-ratio="photo"><img src="https://placehold.co/1600x1200/ECEAE4/5C5B57" alt="" width="1600" height="1200" loading="lazy"></figure>
              <p class="card__meta"><span>Essay</span><span>6 min read</span></p>
              <h3 class="card__title"><a class="card__link" href="/templates/article/">Designing parks for hotter summers</a></h3>
              <p class="card__summary">Shade, water and soil: what a decade of heatwaves has taught us.</p>
            </article>
          </li>
          <li>
            <article class="card">
              <figure class="card__media media" data-ratio="photo"><img src="https://placehold.co/1600x1200/ECEAE4/5C5B57" alt="" width="1600" height="1200" loading="lazy"></figure>
              <p class="card__meta"><span>Process</span><span>4 min read</span></p>
              <h3 class="card__title"><a class="card__link" href="/templates/article/">Why every street starts with a walk</a></h3>
              <p class="card__summary">The observation method behind our street projects, step by step.</p>
            </article>
          </li>
          <li>
            <article class="card">
              <figure class="card__media media" data-ratio="photo"><img src="https://placehold.co/1600x1200/ECEAE4/5C5B57" alt="" width="1600" height="1200" loading="lazy"></figure>
              <p class="card__meta"><span>News</span><span>2 min read</span></p>
              <h3 class="card__title"><a class="card__link" href="/templates/article/">Fieldwork opens a Glasgow studio</a></h3>
              <p class="card__summary">Eight people, one long table and a view of the Clyde.</p>
            </article>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" data-surface="brand" aria-labelledby="cta-title">
      <div class="container">
        <div class="cta" data-layout="inline">
          <div class="cta__content">
            <h2 class="text-page-title" id="cta-title">Have a site in mind?</h2>
            <p class="cta__text">Tell us about the place and the people who use it. We reply to every enquiry within two working days.</p>
          </div>
          <div class="cta__actions">
            <div class="button-group" data-stack="mobile">
              <a class="button" href="/templates/contact/">Start a project <svg class="icon" data-icon="arrow-right" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
              <a class="button" data-variant="secondary" href="/templates/case-studies/">See our work</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</FieldworkLayout>
