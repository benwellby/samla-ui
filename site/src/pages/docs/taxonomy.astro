---
import { getEntry, render } from 'astro:content';
import DocsPage from '../../layouts/DocsPage.astro';
import { extractTitle, extractDescription } from '../../data/docsMeta';

const entry = await getEntry('docs', 'taxonomy');
const { Content, headings } = await render(entry);
const title = extractTitle(entry.body ?? '');
const description = extractDescription(entry.body ?? '');
---

<DocsPage title={title} description={description} current="/docs/taxonomy/" sourcePath="docs/taxonomy.md" headings={headings}>
  <Content />
</DocsPage>
