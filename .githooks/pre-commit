#!/bin/sh
# Samla pre-commit hook: regenerate the HTML docs and shared headers/footers
# so the committed site always matches its Markdown and partials sources.
# Enable once per clone:  git config core.hooksPath .githooks

command -v node >/dev/null 2>&1 || { echo "pre-commit: node not found, skipping doc rebuild"; exit 0; }

# HTML files that already had unstaged edits before we run. We won't stage
# those automatically, because that could commit unrelated work in progress.
dirty_before=$(git diff --name-only -- '*.html')

node scripts/build-docs.mjs >/dev/null || exit 1
node scripts/sync-partials.mjs >/dev/null || exit 1

changed=$(git diff --name-only -- '*.html')
for file in $changed; do
  if echo "$dirty_before" | grep -qx "$file"; then
    echo "pre-commit: $file has unstaged edits and was also regenerated; review and stage it yourself."
  else
    git add -- "$file"
    echo "pre-commit: updated $file"
  fi
done

exit 0
